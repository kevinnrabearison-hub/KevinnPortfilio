# Backend environment variables for production
# Copy this file to backend/.env locally if needed.
# Never commit real secrets.

# PostgreSQL connection string from Neon or Render Postgres
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# JWT secret for admin auth
JWT_SECRET=replace_with_a_strong_random_secret

# Admin login: use either ADMIN_PASSWORD_HASH or ADMIN_PASSWORD
# Recommended: generate bcrypt hash and set ADMIN_PASSWORD_HASH
ADMIN_PASSWORD=replace_with_a_strong_admin_password
# ADMIN_PASSWORD_HASH=$2a$12$your_generated_hash_here...

# CORS origin for the frontend (Vercel URL)
FRONTEND_URL=https://your-frontend.vercel.app

# Optional email settings if you use Nodemailer notifications
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_app_password_here
